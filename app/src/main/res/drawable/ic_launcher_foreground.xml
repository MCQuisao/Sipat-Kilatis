<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome app icon: a loupe over a shield, in Ink. Content stays inside the 66dp safe zone of the 108dp
     adaptive canvas. Also used as the themed (monochrome) icon on Android 13+ and as the splash icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Shield -->
    <path
        android:strokeColor="@color/icon_ink"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:pathData="M54,29 L35,36.5 L35,50 C35,62.5 43,73.5 54,77 C65,73.5 73,62.5 73,50 L73,36.5 Z" />
    <!-- Loupe lens -->
    <path
        android:strokeColor="@color/icon_ink"
        android:strokeWidth="4"
        android:pathData="M42,51 A9,9 0 1,0 60,51 A9,9 0 1,0 42,51 Z" />
    <!-- Loupe handle -->
    <path
        android:strokeColor="@color/icon_ink"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M57.5,57.5 L65,65" />
</vector>
